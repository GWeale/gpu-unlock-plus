# `make dist` ships only the source needed to build the packages.
/* export-ignore
/VERSION -export-ignore
/Makefile -export-ignore
/README.md -export-ignore
/LICENSE -export-ignore
/CHANGELOG.md -export-ignore
/CONTRIBUTING.md -export-ignore
/SECURITY.md -export-ignore
/UPSTREAM.md -export-ignore
# Preserve the archived upstream Markdown hard breaks verbatim.
/UPSTREAM.md whitespace=-blank-at-eol
/gpu-unlock-plus -export-ignore
/gpu_unlock_plus -export-ignore
/docs -export-ignore
/assets -export-ignore
/tests -export-ignore
/firmware -export-ignore
/kernel -export-ignore
/licenses -export-ignore
/packaging -export-ignore
*.bin export-ignore
*.rom export-ignore
*.cu export-ignore
/debian -export-ignore
